{
  "name": "latent-field-model-lab",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local generative graphics with fractal fields, InceptionV3 feature visualization, and optional browser training.",
  "scripts": {
    "prepare:ort": "node tools/prepare-ort.mjs",
    "check": "node tools/check.mjs && npm run lint",
    "lint": "eslint assets/js tools tests *.mjs",
    "format": "prettier --write assets/js assets/css *.html tools tests *.mjs *.json .github",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "build": "npm run prepare:ort && npm run prepare:tfjs && npm run check && node tools/build.mjs",
    "start": "node server.mjs dist",
    "dev": "npm run prepare:ort && npm run prepare:tfjs && node server.mjs .",
    "prepare:tfjs": "node tools/prepare-tfjs.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "onnxruntime-web": "1.27.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
